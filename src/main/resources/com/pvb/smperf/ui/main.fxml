<?xml version="1.0" encoding="UTF-8"?>

<?import com.pvb.smperf.ui.GroupBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pvb.smperf.ui.MainController"
            fx:id="root"
            styleClass="win-window">

    <!-- Menus. Navigation lives ONLY in the tab strip (added by Workspace); File/Edit items are
         added by SessionActions. -->
    <top>
        <MenuBar fx:id="menuBar"/>
    </top>

    <!-- Home page: configure along the top, watch the run in the log that fills the rest -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="8" left="10"/>
            </padding>

            <HBox spacing="10">
                <GroupBox title="Target program" HBox.hgrow="ALWAYS" maxHeight="Infinity">
                    <Label text="Executable" styleClass="field-label"/>
                    <HBox spacing="6">
                        <TextField fx:id="binaryField" editable="false"
                                   promptText="Select a program to benchmark"
                                   HBox.hgrow="ALWAYS"/>
                        <Button text="Browse…" onAction="#chooseBinary"/>
                    </HBox>
                    <Label fx:id="selectedInfo" text="No executable selected" styleClass="note"/>

                    <Label text="Input file (optional)" styleClass="field-label">
                        <padding><Insets top="6" right="0" bottom="0" left="0"/></padding>
                    </Label>
                    <HBox fx:id="inputRow" spacing="6">
                        <TextField fx:id="inputField" editable="false"
                                   promptText="None — passed to the program as an argument"
                                   HBox.hgrow="ALWAYS"/>
                        <Button text="Browse…" onAction="#chooseInput"/>
                        <Button text="Clear" onAction="#clearInput"/>
                    </HBox>
                    <Label styleClass="note" wrapText="true"
                           text="Put {input} in Arguments to place the path (e.g. --in {input}); otherwise it is appended as the last argument."/>

                    <Label text="Arguments" styleClass="field-label">
                        <padding><Insets top="6" right="0" bottom="0" left="0"/></padding>
                    </Label>
                    <TextArea fx:id="argumentsField" styleClass="code-area" wrapText="false"
                              prefRowCount="4" VBox.vgrow="ALWAYS"/>
                    <Label styleClass="note" wrapText="true"
                           text="Split like a shell: spaces separate arguments, use &quot;double&quot; or 'single' quotes to keep spaces. {threads} = thread count of each run."/>
                </GroupBox>

                <GroupBox title="Run settings" minWidth="330" prefWidth="330" maxWidth="330">
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="96" prefWidth="100"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Threads" styleClass="field-label" GridPane.rowIndex="0"/>
                        <HBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <ComboBox fx:id="threadMode" minWidth="112" prefWidth="112"/>
                            <TextField fx:id="threadField" text="1,2,4,8" promptText="1,2,4,8"
                                       HBox.hgrow="ALWAYS" minWidth="40"/>
                        </HBox>

                        <Label text="Repetitions" styleClass="field-label" GridPane.rowIndex="1"/>
                        <Spinner fx:id="repeats" editable="true" maxWidth="Infinity"
                                 GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Warmup runs" styleClass="field-label" GridPane.rowIndex="2"/>
                        <Spinner fx:id="warmup" editable="true" maxWidth="Infinity"
                                 GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Timeout (s)" styleClass="field-label" GridPane.rowIndex="3"/>
                        <TextField fx:id="timeout" text="60"
                                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </GridPane>
                </GroupBox>

                <GroupBox title="Detected machine" minWidth="290" prefWidth="290" maxWidth="290">
                    <GridPane hgap="10" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints minWidth="52" prefWidth="52"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="CPU" styleClass="key" GridPane.rowIndex="0"/>
                        <Label fx:id="mCpu" text="Detecting hardware…" styleClass="val" wrapText="true"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Cores" styleClass="key" GridPane.rowIndex="1"/>
                        <Label fx:id="mCores" text="-" styleClass="val" wrapText="true"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Memory" styleClass="key" GridPane.rowIndex="2"/>
                        <Label fx:id="mMem" text="-" styleClass="val"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    </GridPane>
                </GroupBox>
            </HBox>

            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Button fx:id="runButton" text="Run Benchmark" styleClass="primary-button"
                        minWidth="200" onAction="#startBenchmark"/>
                <Button fx:id="cancelButton" text="Cancel" disable="true" minWidth="100"
                        onAction="#cancelBenchmark"/>
            </HBox>

            <GroupBox title="Run log" VBox.vgrow="ALWAYS">
                <TextArea fx:id="logArea" styleClass="code-area" editable="false" wrapText="false"
                          promptText="Progress of the current run shows up here."
                          VBox.vgrow="ALWAYS"/>
            </GroupBox>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="4">
            <Label fx:id="footerStatus" text="Ready" styleClass="status-panel"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <ProgressBar fx:id="runProgress" progress="-1" prefWidth="150" visible="false" managed="false"/>
            <Label fx:id="footerResults" text="No results" styleClass="status-panel" minWidth="110"/>
            <Label fx:id="footerEngine" text="Engine: …" styleClass="status-panel" minWidth="110"/>
            <Label text="SMPerf 1.0" styleClass="status-panel"/>
        </HBox>
    </bottom>
</BorderPane>